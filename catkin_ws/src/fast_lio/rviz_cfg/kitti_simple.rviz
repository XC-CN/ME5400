# ------------------------------------------------------------
# KITTI 可视化 RViz 配置文件
# 作用：仅用于离线回放 /kitti/velo/pointcloud 点云并快速查看
# 使用说明：
#   1. 若点云不显示，首先确认 Fixed Frame 与消息中的 frame_id 一致。
#   2. 可在 Displays 面板中勾选/取消 “KITTI PointCloud” 来调节开关。
#   3. 若想加轨迹，可添加 Path 显示并订阅 /path。
#   4. 如果使用其它数据集，可修改 Topic 字段。
#   5. Window Geometry 里是窗口大小位置，删除或调整不会影响功能。
# ------------------------------------------------------------
# Panels:  # RViz 面板配置列表
#   - Class: rviz/Displays  # 显示面板类
#     Help Height: 78  # 帮助区域高度
#     Name: Displays  # 面板名称
#     Property Tree Widget:  # 属性树控件
#       Expanded:  # 展开的项目
#         - /Global Options1  # 全局选项
#         - /Status1  # 状态
#         - /KITTI PointCloud1  # KITTI 点云
#       Splitter Ratio: 0.5  # 分割比例
#     Tree Height: 565  # 树高度
#   - Class: rviz/Selection  # 选择面板类
#     Name: Selection  # 面板名称
#   - Class: rviz/Tool Properties  # 工具属性面板类
#     Expanded:  # 展开的项目
#       - /2D Pose Estimate1  # 2D 姿态估计
#       - /2D Nav Goal1  # 2D 导航目标
#       - /Publish Point1  # 发布点
#     Name: Tool Properties  # 面板名称
#     Splitter Ratio: 0.5886790156364441  # 分割比例
#   - Class: rviz/Views  # 视图面板类
#     Expanded:  # 展开的项目
#       - /Current View1  # 当前视图
#     Name: Views  # 面板名称
#     Splitter Ratio: 0.5  # 分割比例
#   - Class: rviz/Time  # 时间面板类
#     Experimental: false  # 是否实验性
#     Name: Time  # 面板名称
#     SyncMode: 0  # 同步模式
#     SyncSource: "KITTI PointCloud"  # 同步源

# 首选项（注：已注释以保持默认行为）
Preferences:  # 首选项配置
  PromptSaveOnExit: False   # 退出时提示保存

# 工具栏设置（注释以使用 RViz 默认样式）
Toolbars:  # 工具栏配置
  toolButtonStyle: 2       # 按钮样式：0=图标,1=文本,2=图标+文本（视 RViz 版本而定）

# 主配置节点，以下是所有显示插件与全局选项
Visualization Manager:  
  Class: ""  # 类（空）
  Displays:  # 显示列表
    - Alpha: 0.5          # 网格透明度
      Cell Size: 10  # 单元格大小
      Class: rviz/Grid  # 网格显示类
      Color: 160; 160; 164  # 颜色
      Enabled: true  # 是否启用
      Line Style:  # 线样式
        Line Width: 0.029999999329447746  # 线宽
        Value: Lines  # 值
      Name: Grid  # 名称
      Normal Cell Count: 0  # 法向单元格计数
      Offset:  # 偏移
        X: 0  # X 偏移
        Y: 0  # Y 偏移
        Z: 0  # Z 偏移
      Plane: XY  # 平面
      Plane Cell Count: 100  # 平面单元格计数
      Reference Frame: <Fixed Frame>  # 参考帧
      Value: true  # 值
    - Alpha: 1            # 点云显示：主点云（KITTI）
      Autocompute Intensity Bounds: true  # 自动计算强度边界
      Autocompute Value Bounds:  # 自动计算值边界
        Max Value: 10  # 最大值
        Min Value: -10  # 最小值
        Value: true  # 值
      Axis: Z  # 轴
      Channel Name: intensity  # 通道名称
      Class: rviz/PointCloud2  # 点云2显示类
      Color: 255; 255; 255  # 颜色
      Color Transformer: Intensity  # 颜色变换器
      Decay Time: 0  # 衰减时间
      Enabled: true  # 是否启用
      Invert Rainbow: false  # 是否反转彩虹
      Max Color: 255; 255; 255  # 最大颜色
      Min Color: 0; 0; 0  # 最小颜色
      Name: KITTI PointCloud  # 名称
      Position Transformer: XYZ  # 位置变换器
      Queue Size: 10  # 队列大小
      Selectable: true  # 是否可选择
      Size (Pixels): 3  # 大小（像素）
      Size (m): 0.05000000074505806  # 大小（米）
      Style: Points  # 样式
      Topic: /kitti/velo/pointcloud  # 话题
      Unreliable: false  # 是否不可靠
      Use Fixed Frame: true  # 使用固定帧
      Use rainbow: true  # 使用彩虹
      Value: true  # 值
    - Class: rviz/Axes    # 原点坐标轴
      Enabled: true  # 是否启用
      Length: 5  # 长度
      Name: Coordinate Axes  # 名称
      Radius: 0.5  # 半径
      Reference Frame: <Fixed Frame>  # 参考帧
      Value: true  # 值
  Enabled: true  # 是否启用
  Global Options:  # 全局坐标 / 背景等
    Background Color: 48; 48; 48  # 背景颜色
    Default Light: true  # 默认光照
    Fixed Frame: kitti/velo/pointcloud  # 固定帧
    Frame Rate: 30  # 帧率
  Name: root  # 名称
  Tools:  # 工具列表
    - Class: rviz/Interact  # 交互工具类
      Hide Inactive Objects: true  # 隐藏非活动对象
    - Class: rviz/MoveCamera  # 移动相机工具类
    - Class: rviz/Select  # 选择工具类
    - Class: rviz/FocusCamera  # 聚焦相机工具类
    - Class: rviz/Measure  # 测量工具类
    - Class: rviz/SetInitialPose  # 设置初始姿态工具类
      Theta std deviation: 0.2617993950843811  # Theta 标准差
      Topic: /initialpose  # 话题
      X std deviation: 0.5  # X 标准差
      Y std deviation: 0.5  # Y 标准差
    - Class: rviz/SetGoal  # 设置目标工具类
      Topic: /move_base_simple/goal  # 话题
    - Class: rviz/PublishPoint  # 发布点工具类
      Single click: true  # 单次点击
      Topic: /clicked_point  # 话题
  Value: true  # 值
  Views:            # 视角参数（Orbit 相机）
    Current:  # 当前视图
      Class: rviz/Orbit  # 轨道视图类
      Distance: 50  # 距离
      Enable Stereo Rendering:  # 启用立体渲染
        Stereo Eye Separation: 0.05999999865889549  # 立体眼分离
        Stereo Focal Distance: 1  # 立体焦距
        Swap Stereo Eyes: false  # 交换立体眼
        Value: false  # 值
      Focal Point:  # 焦点
        X: 0  # X
        Y: 0  # Y
        Z: 0  # Z
      Focal Shape Fixed Size: true  # 焦点形状固定大小
      Focal Shape Size: 0.05000000074505806  # 焦点形状大小
      Invert Z Axis: false  # 反转 Z 轴
      Name: Current View  # 名称
      Near Clip Distance: 0.009999999776482582  # 近裁剪距离
      Pitch: 0.5  # 俯仰
      Target Frame: <Fixed Frame>  # 目标帧
      Value: Orbit (rviz)  # 值
      Yaw: 0.5  # 偏航
    Saved: ~  # 保存的视图（空）
    
Window Geometry:            # 恢复为精简默认窗口参数（RViz 若需会自动覆盖）
  Displays:  # 显示面板
    collapsed: true  # 是否折叠
  Height: 3840              # 常见 1080p 屏幕可视区域高度（含标题栏）
  Hide Left Dock: true  # 隐藏左侧停靠
  Hide Right Dock: true  # 隐藏右侧停靠
  Selection:  # 选择面板
    collapsed: true  # 是否折叠
  Time:  # 时间面板
    collapsed: true  # 是否折叠
  Tool Properties:  # 工具属性面板
    collapsed: true  # 是否折叠
  Views:  # 视图面板
    collapsed: true  # 是否折叠
  Width: 2160               # 默认宽度
  X: 50                     # 窗口左上角位置
  Y: 50